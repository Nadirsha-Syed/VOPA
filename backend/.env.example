# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# Local:   mongodb://localhost:27017/vopa_db
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/vopa_db
MONGO_URI=

# ─── JWT ──────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── AI / Speech Service (added later) ────────────────────
AI_API_KEY=
AI_PROVIDER=

# ─── File Upload ──────────────────────────────────────────
MAX_AUDIO_SIZE_MB=10

# ─── Fixed Platform Administrator ──────────────────────────
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL=admin@vopa.org
ADMIN_PASSWORD=Admin@123456
